generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Patient {
  id           String        @id @default(cuid())
  fullName     String
  phone        String
  notes        String?
  createdAt    DateTime      @default(now())
  appointments Appointment[]

  @@index([phone])
}

model Appointment {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service   String
  date      DateTime @db.Date
  timeSlot  String
  status    String   @default("pending") // pending | confirmed | cancelled
  note      String?
  createdAt DateTime @default(now())

  // نفس التاريخ + الوقت ما بينحجز مرتين
  @@unique([date, timeSlot])
  @@index([date])
}

model BlockedSlot {
  id       String   @id @default(cuid())
  date     DateTime @db.Date
  timeSlot String
  reason   String?

  @@unique([date, timeSlot])
  @@index([date])
}

model StaffUser {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("doctor") // doctor | secretary
  createdAt    DateTime @default(now())
}
