# انسخ هذا الملف وسمّيه .env وعبّي القيم الحقيقية من neon.tech
# لا ترفع ملف .env على GitHub أبداً.

# الرابط اللي فيه "-pooler"
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# نفس الرابط بدون "-pooler"
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/neondb?sslmode=require"

# نص عشوائي طويل لتوقيع الجلسات
# ولّده بالأمر: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-long-random-string"

# كلمة مرور حساب الأدمن الأول — تُستعمل مرة واحدة عند: npm run seed
SEED_ADMIN_PASSWORD=""
